# .env.example — Copy this file to .env and fill in your real values
#   cp .env.example .env
#
# Every variable marked REQUIRED is validated at boot by src/config/env.js.
# The server refuses to start if any of them is missing.

# --- Database (REQUIRED: this OR the five DB_* vars below) -----------------
# Postgres connection string. `docker compose up db` serves the value below.
# This is the local/CI/test path; Phase 6's Lambda deploy uses the discrete
# DB_HOST/DB_PORT/DB_NAME/DB_SECRET_ARN/DB_SSL_CA_PATH vars instead, because
# RDS's password lives in Secrets Manager, not a connection string.
DATABASE_URL=postgres://dejavu:dejavu@localhost:5432/dejavu

# --- Database, Lambda path (alternative to DATABASE_URL) -------------------
# Set DB_HOST, DB_NAME and DB_SECRET_ARN together (never a subset — boot
# fails on a partial set) to connect to RDS instead of a connection string.
# DB_USER is populated by src/lambda.js from the secret at cold start, not
# set here. DB_PORT defaults to 5432; DB_SSL_CA_PATH defaults to the bundle
# committed at backend/certs/rds-global-bundle.pem.
# DB_HOST=dejavu-dev.xxxxxxxxxx.us-east-1.rds.amazonaws.com
# DB_NAME=dejavu
# DB_SECRET_ARN=arn:aws:secretsmanager:us-east-1:<account-id>:secret:rds!db-...

# --- Auth (REQUIRED) -------------------------------------------------------
# Signs and verifies every JWT, including admin tokens. Minimum 32 characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=generate-a-long-random-value-do-not-reuse-this-line

# --- Stripe (REQUIRED) -----------------------------------------------------
# Dashboard > Developers > API keys
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key

# From `stripe listen --forward-to localhost:5000/api/webhooks/stripe`,
# or Dashboard > Developers > Webhooks after creating an endpoint.
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-signing-secret

# --- Optional --------------------------------------------------------------
# Base URL used to build Stripe success/cancel redirects.
# Default: https://dejavustudio.xyz  (set to http://localhost:5173 for local dev)
FRONTEND_URL=http://localhost:5173

# Port the API listens on. Default: 5000
PORT=5000

# Max connections in the pg pool. Default: 10
PG_POOL_MAX=10

# pino log level: fatal | error | warn | info | debug | trace | silent
# Default: info, or silent when NODE_ENV=test.
LOG_LEVEL=info

# Number of reverse proxies in front of the app, for Express's `trust proxy`.
# The rate limiters key on the client IP: leave it 0 with no proxy, and set it
# to the real hop count behind one. Too low merges every client into a single
# bucket; too high lets a client spoof X-Forwarded-For for an unlimited one.
TRUST_PROXY=0

# Comma-separated list of allowed CORS origins.
# Default: https://dejavustudio.xyz,https://dejavu-seven.vercel.app,http://localhost:5173
CORS_ORIGINS=http://localhost:5173
